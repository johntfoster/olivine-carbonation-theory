{
  "name": "Olivine carbonation — compiled MOOSE and scientific Python",
  "image": "ghcr.io/johntfoster/olivine-carbonation-theory:main",
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "waitFor": "postCreateCommand",
  "containerEnv": {"MOOSE_DIR": "/opt/moose"},
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-vscode.cpptools", "James-Yu.latex-workshop"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/moose/bin/python",
        "latex-workshop.latex.autoBuild.run": "never"
      }
    }
  },
  "hostRequirements": {"cpus": 4, "memory": "8gb", "storage": "32gb"}
}
